{
  "name": "agent-tool",
  "version": "0.1.0",
  "description": "Run multiple AI coding agents in parallel using isolated Multipass VMs",
  "type": "module",
  "bin": {
    "agent-tool": "./dist/cli.js",
    "agent-tool-docker": "./dist-docker/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node",
    "build:docker": "bun build src-docker/cli.ts --outdir dist-docker --target node",
    "dev": "bun run src/cli.ts --",
    "dev:docker": "bun run src-docker/cli.ts --",
    "start": "bun dist/cli.js"
  },
  "keywords": [
    "ai",
    "agent",
    "multipass",
    "vm",
    "parallel"
  ],
  "author": "Ben Schoolland",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^7.0.2",
    "typescript": "^5.9.3"
  }
}
